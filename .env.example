# ==========================================
# YouTube Shorts Production Engine Environment
# Copy this file to .env and fill in your values
# ==========================================

# SMTP Notification Configuration (for dispatching review emails with video attachments)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password

# Recipient Email (where review packages are delivered)
NOTIFICATION_EMAIL=creator@example.com

# Remote Dashboard Port (default: 4100)
DASHBOARD_PORT=4100

# Antigravity CLI (agy) Persistent Conversation Context
# Reusing a persistent conversation ID allows the agent to maintain continuous memory, feedback, and skills
AGY_CONVERSATION_ID=your-persistent-conversation-uuid
AGY_BIN_PATH=/home/youruser/.local/bin/agy
