    "express": "^5.3.0",
    "nodemailer": "^6.9.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.19.0",
