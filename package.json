{
  "name": "yt-shorts-engine",
  "version": "1.0.0",
  "description": "YouTube Shorts Automated Production Workflow",
  "type": "module",
  "main": "dist/workflow.js",
  "types": "dist/workflow.d.ts",
  "scripts": {
    "start": "tsx src/workflow.ts",
    "job": "tsx src/runner.ts",
    "dashboard": "tsx src/server.ts",
    "workflow": "tsx src/workflow.ts",
    "update-calendar": "tsx scripts/update-calendar-times.ts",
    "chrome:debug": "google-chrome --remote-debugging-port=9333",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.539",
    "@remotion/media": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
